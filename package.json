{
  "name": "tactics-sandbox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Single-player tactics-RPG engine prototype: FE combat grammar, data-driven units, headless deterministic simulation.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
